# ───────────────────────────────────────────────
# LeadBridge AI — مهدیار هوش‌افزا
# این فایل را به .env.local کپی کنید و مقادیر را پر کنید.
# کلیدها هرگز کامیت نمی‌شوند (.gitignore).
# ───────────────────────────────────────────────

# ── مدل زبانی (اجباری برای فازهای تحلیل/پیام) ───────────────
# همه‌ی ایجنت‌ها از طریق OpenRouter کار می‌کنند (یک کلید برای همه‌ی مدل‌ها).
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# مدل پیش‌فرض همه‌ی ایجنت‌ها (slug از openrouter.ai/models).
# gpt-oss-20b با تست واقعی روی لیدهای فارسی انتخاب شد: فارسی روان و JSON پایدار.
PIPELINE_MODEL=openai/gpt-oss-20b:free
# اختیاری: مدل قوی‌تر فقط برای ایجنت «نویسنده‌ی پیام»
# WRITER_MODEL=anthropic/claude-sonnet-4.5
# اختیاری: زنجیره‌ی جایگزین هنگام 429/503 (پیش‌فرض سه مدل رایگان).
# ⚠️ اگر PIPELINE_MODEL را پولی کردی این را هم ست کن، وگرنه یک ۴۲۹ گذرا
# بی‌صدا به مدل رایگان سقوط می‌کند و کیفیت بدون هیچ هشداری عوض می‌شود.
# MODEL_FALLBACKS=model-a,model-b

# ── ذخیره‌سازی CRM (Supabase — اجباری برای پروداکشن) ────────
# اسکیمای جدول‌ها: supabase/schema.sql را در SQL Editor اجرا کنید.
# بدون این‌ها سیستم در «حالت حافظه» اجرا می‌شود (داده با ری‌استارت پاک می‌شود).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── کشف لید ─────────────────────────────────────────────────
# منبع پیش‌فرض: OpenStreetMap (رایگان، بدون کلید، بدون کارت) — نیازی به تنظیم نیست.
# اختیاری: اگر کلید Google Places (New) داری، با تنظیم آن، کشف از گوگل انجام می‌شود.
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ── تحلیل اینستاگرام (Graph API رسمی حساب بیزینس مهدیار) ────
# business_discovery فقط داده‌ی عمومی پیج هدف را می‌خواند.
IG_ACCESS_TOKEN=your-instagram-graph-access-token
IG_BUSINESS_ID=your-ig-business-account-id

# ── جست‌وجوی وب در دکمه‌ی «کشف لید» (اختیاری، رایگان، بدون کارت) ──
# کلید رایگان از tavily.com — اگر تنظیم شود، «کشف لید» علاوه بر OSM، وب را هم
# می‌گردد و کسب‌وکارها (به‌ویژه اینستاگرام) را اضافه می‌کند. بدون کلید، فقط OSM.
# TAVILY_API_KEY=tvly-xxxxxxxxxxxx

# ── جست‌وجوی گوگل (اختیاری؛ منبع سوم کشف) ──────────────────
# ایندکس گوگل روی سایت‌های فارسیِ کوچک کامل‌تر از ایندکس‌های دیگر است — یعنی
# دقیقاً همان کسب‌وکارهای هدف این پروژه. موازی با Tavily اجرا می‌شود، پس
# اضافه‌کردنش زمان کشف را بلندتر نمی‌کند.
#
# هر دو مقدار لازم است، وگرنه این منبع بی‌صدا رد می‌شود:
#   ۱. GOOGLE_SEARCH_ENGINE_ID — از programmablesearchengine.google.com
#      یک موتور بساز و روی «Search the entire web» تنظیمش کن، بعد Search
#      engine ID را بردار.
#   ۲. GOOGLE_SEARCH_API_KEY — از console.cloud.google.com، پس از فعال‌کردن
#      «Custom Search API» یک API key بساز.
# سهمیه‌ی رایگان: روزی ۱۰۰ کوئری. هر «کشف لید» حداکثر ۸ تا مصرف می‌کند.
# GOOGLE_SEARCH_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXX
# GOOGLE_SEARCH_ENGINE_ID=a1b2c3d4e5f6g7h8i

# ── امنیت داشبورد (برای دیپلوی عمومی توصیه می‌شود) ──────────
# اگر تنظیم شود، صفحه‌ی /studio و APIهای مدیریتی رمز می‌خواهند.
# STUDIO_PASSWORD=یک-رمز-قوی

# ── اجرای خودکار روزانه (کرون Vercel — فاز ۵) ───────────────
# بسازید با: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# CRON_SECRET=یک-رشته-تصادفی

# ── آدرس پایه‌ی سایت (اختیاری) ──────────────────────────────
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
